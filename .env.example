# HT-03: PII heshlash kaliti. Ishlab chiqarishda ALBATTA o'zgartiring
# va sir menejerida saqlang (TZ 4.1.3-band).
UCW_PII_PEPPER=change-me-32-bytes-random

# Ma'lumotlar bazasi
UCW_DB_DSN=postgresql+psycopg://ucw:ucw@postgres:5432/uzcyberwatch

# Kollektorlar
UCW_CT_MIN_RISK=30
UCW_CERTSTREAM_URL=wss://certstream.calidog.io/

# Tashqi boyitish xizmatlari (ixtiyoriy, bo'sh qolsa modul o'chiriladi)
UCW_VT_API_KEY=
UCW_URLSCAN_API_KEY=
UCW_MAXMIND_DB=/data/GeoLite2-City.mmdb
